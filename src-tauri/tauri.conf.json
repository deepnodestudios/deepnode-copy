{
  "$schema": "https://schema.tauri.app/v2/config.json",
  "productName": "DeepNode Copy",
  "version": "0.3.2",
  "identifier": "com.deepnode.copy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "DeepNode Copy",
        "width": 960,
        "height": 640,
        "minWidth": 380,
        "minHeight": 180,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "center": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://github.com https://objects.githubusercontent.com https://*.sentry.io https://*.ingest.de.sentry.io; object-src 'none'; frame-src 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": [
      "../bin/deepnode_shell.dll",
      "../bin/AppxManifest.xml",
      "../bin/DeepNodePublic.cer",
      "../bin/Assets/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/Square30x30Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square284x284Logo.png",
      "icons/Square310x310Logo.png",
      "icons/StoreLogo.png"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "../scripts/sign_file.ps1", "%1"]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "hooks.nsh"
      },
      "wix": {
        "bannerPath": "icons/banner.bmp",
        "dialogImagePath": "icons/dialog.bmp"
      }
    }
  }
}
