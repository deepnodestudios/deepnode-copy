{
  "$schema": "https://schema.tauri.app/v2/config.json",
  "productName": "DeepNode Copy",
  "version": "0.1.0",
  "identifier": "com.deepnode.copy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "DeepNode Copy",
        "width": 720,
        "height": 700,
        "minWidth": 460,
        "minHeight": 220,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": [
      "../bin/deepnode_shell.dll"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
